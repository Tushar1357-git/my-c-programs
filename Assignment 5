#include<stdio.h>
#include<string.h>
#include<ctype.h>
int main(){
    char str1[100], str2[100], temp[100];
    int choice, i, len, flag, vowels, consonants;

    do
    {
        printf("\n===== STRING OPERATIONS MENU =====\n");
        printf("1. Find String Length\n");
        printf("2. Copy String\n");
        printf("3. Concatenate Strings\n");
        printf("4. Compare Strings\n");
        printf("5. Reverse String\n");
        printf("6. Convert to Uppercase\n");
        printf("7. Convert to Lowercase\n");
        printf("9. Count Vowels and Consonants\n");
        printf("10. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter a string: ");
                scanf("%99s", str1);

                printf("Length = %lu\n",
                       (unsigned long)strlen(str1));
                break;

            case 2:
                printf("Enter a string: ");
                scanf("%99s", str1);

                strcpy(str2, str1);

                printf("Copied string = %s\n", str2);
                break;

            case 3:
                printf("Enter first string: ");
                scanf("%99s", str1);

                printf("Enter second string: ");
                scanf("%99s", str2);

                if (strlen(str1) + strlen(str2) < sizeof(str1))
                {
                    strcat(str1, str2);
                    printf("Concatenated string = %s\n", str1);
                }
                else
                {
                    printf("Strings are too long!\n");
                }
                break;

            case 4:
                printf("Enter first string: ");
                scanf("%99s", str1);

                printf("Enter second string: ");
                scanf("%99s", str2);

                if (strcmp(str1, str2) == 0)
                    printf("Strings are equal.\n");
                else
                    printf("Strings are not equal.\n");
                break;

            case 5:
                printf("Enter a string: ");
                scanf("%99s", str1);

                len = (int)strlen(str1);

                for (i = 0; i < len; i++)
                    temp[i] = str1[len - 1 - i];

                temp[len] = '\0';

                printf("Reversed string = %s\n", temp);
                break;

            case 6:
                printf("Enter a string: ");
                scanf("%99s", str1);

                for (i = 0; str1[i] != '\0'; i++)
                    str1[i] = (char)toupper((unsigned char)str1[i]);

                printf("Uppercase = %s\n", str1);
                break;

            case 7:
                printf("Enter a string: ");
                scanf("%99s", str1);

                for (i = 0; str1[i] != '\0'; i++)
                    str1[i] = (char)tolower((unsigned char)str1[i]);

                printf("Lowercase = %s\n", str1);
                break;

       

            case 9:
                printf("Enter a string: ");
                scanf("%99s", str1);

                vowels = 0;
                consonants = 0;

                for (i = 0; str1[i] != '\0'; i++)
                {
                    char ch = (char)tolower((unsigned char)str1[i]);

                    if (ch >= 'a' && ch <= 'z')
                    {
                        if (ch == 'a' || ch == 'e' ||
                            ch == 'i' || ch == 'o' ||
                            ch == 'u')
                            vowels++;
                        else
                            consonants++;
                    }
                }

                printf("Vowels = %d\n", vowels);
                printf("Consonants = %d\n", consonants);
                break;

            case 10:
                printf("Exiting program...\n");
                break;

            default:
                printf("Invalid choice!\n");
        }

    } while (choice != 10);

    return 0;
}
